# Copia este archivo como .env y ajusta los valores. .env no se versiona.

# PostgreSQL
DATABASE_URL="postgresql://zarape:zarape@localhost:5432/zarape?schema=public"

# Puerto de la API
PORT=3000

# Orígenes permitidos por CORS, separados por coma (apps de Vite en desarrollo)
CORS_ORIGENES="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Secreto para firmar los JWT. Obligatorio en producción (cadena larga y aleatoria).
JWT_SECRETO="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Seed (opcional): contraseñas de los usuarios admin y cocina al crearlos.
# Si se dejan vacías, el seed genera unas de 12 caracteres y las imprime una vez.
SEED_CONTRASENA_ADMIN=""
SEED_CONTRASENA_COCINA=""

# Pruebas e2e (opcional): BD de PostgreSQL para `pnpm test`. Sin esta variable, las e2e se saltan.
# Las pruebas crean y borran sus propios registros (prefijo "e2e-").
DATABASE_URL_PRUEBAS=""
