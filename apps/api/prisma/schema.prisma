// El Zarape: modelo de datos (fuente de verdad; se documenta en docs/modelo-de-datos.md).
//
// Convenciones:
// - Código en inglés: modelos y campos en camelCase; tablas y columnas en snake_case (@map / @@map).
// - Dinero en decimal(10,2), nunca float. Los precios del catálogo incluyen IVA.
// - Borrado: físico solo si no hay registros relacionados; si los hay, status = INACTIVE.
//   Por eso las relaciones hacia catálogos usan onDelete: Restrict.
//
// Reglas que Prisma no puede expresar aquí (CHECK) viven en la migración inicial:
//   prisma/migrations/20261110000000_init/migration.sql

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// Estatus de catálogos, empleados y clientes. INACTIVE = baja lógica.
enum Status {
  ACTIVE
  INACTIVE

  @@map("status")
}

enum Role {
  ADMIN
  KITCHEN

  @@map("role")
}

enum CategoryType {
  FOOD
  DRINK

  @@map("category_type")
}

enum Channel {
  KIOSK
  DRIVE_THRU

  @@map("channel")
}

enum OrderStatus {
  PENDING
  PAID
  IN_KITCHEN
  READY
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum ProductType {
  FOOD
  DRINK
  COMBO

  @@map("product_type")
}

enum PaymentStatus {
  APPROVED
  DECLINED

  @@map("payment_status")
}

// ─── Módulo I: catálogos (RF02–RF06) ──────────────────────────────────────────

/// RF02: sucursal.
model Branch {
  id        Int     @id @default(autoincrement())
  name      String
  address   String
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  photoUrl  String  @map("photo_url")
  url       String
  hours     String
  status    Status  @default(ACTIVE)

  employees         Employee[]
  orders            Order[]
  marketingExpenses MarketingExpense[]

  @@map("branch")
}

/// RF03: empleado. La contraseña aleatoria de 12 caracteres se guarda como hash (bcrypt).
model Employee {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  passwordHash String  @map("password_hash")
  role         Role
  branchId     Int?    @map("branch_id")
  status       Status  @default(ACTIVE)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@map("employee")
}

/// Categorías de alimentos (Platillos, Ensaladas…) y de bebidas (Refrescos, Aguas…).
/// Con estatus para aplicar la regla de eliminar: si tiene productos, pasa a INACTIVE.
model Category {
  id     Int          @id @default(autoincrement())
  name   String
  type   CategoryType
  status Status       @default(ACTIVE)

  foods  Food[]
  drinks Drink[]

  @@map("category")
}

/// RF04: alimento.
model Food {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  photoUrl    String  @map("photo_url")
  price       Decimal @db.Decimal(10, 2)
  categoryId  Int     @map("category_id")
  status      Status  @default(ACTIVE)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  combos     ComboFood[]
  orderItems OrderItem[]

  @@map("food")
}

/// RF05: bebida.
model Drink {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  photoUrl    String  @map("photo_url")
  price       Decimal @db.Decimal(10, 2)
  categoryId  Int     @map("category_id")
  status      Status  @default(ACTIVE)

  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  combos     ComboDrink[]
  orderItems OrderItem[]

  @@map("drink")
}

/// RF06: combo de alimentos y bebidas.
model Combo {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  photoUrl    String  @map("photo_url")
  price       Decimal @db.Decimal(10, 2)
  status      Status  @default(ACTIVE)

  foods      ComboFood[]
  drinks     ComboDrink[]
  orderItems OrderItem[]

  @@map("combo")
}

model ComboFood {
  comboId  Int @map("combo_id")
  foodId   Int @map("food_id")
  quantity Int @default(1)

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  food  Food  @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@id([comboId, foodId])
  @@map("combo_food")
}

model ComboDrink {
  comboId  Int @map("combo_id")
  drinkId  Int @map("drink_id")
  quantity Int @default(1)

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  drink Drink @relation(fields: [drinkId], references: [id], onDelete: Restrict)

  @@id([comboId, drinkId])
  @@map("combo_drink")
}

// ─── Módulo III: cliente del drive thru (RF17) ───────────────────────────────

/// RF17. Nunca se borra: se da de baja con status = INACTIVE (RDF1702).
model Customer {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  passwordHash String  @map("password_hash")
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  phone        String
  status       Status  @default(ACTIVE)

  paymentMethod PaymentMethod?
  orders        Order[]

  @@map("customer")
}

/// Medio de pago del cliente. Nunca se guarda el número completo ni el CVV.
model PaymentMethod {
  id            Int    @id @default(autoincrement())
  customerId    Int    @unique @map("customer_id")
  holderName    String @map("holder_name")
  brand         String
  last4         String @db.Char(4)
  expMonth      Int    @map("exp_month")
  expYear       Int    @map("exp_year")
  streetAddress String @map("street_address")
  neighborhood  String
  city          String
  state         String
  postalCode    String @map("postal_code") @db.Char(5)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("payment_method")
}

// ─── Comandas y pagos (RF09–RF13, RF19, RF20) ────────────────────────────────

/// RF10: comanda. El QR usa qr_token (UUID), nunca el id consecutivo.
/// ticketNumber: turno, consecutivo diario por sucursal; ticketDate es el día local en que se asignó (al pagar).
model Order {
  id           Int         @id @default(autoincrement())
  qrToken      String      @unique @default(dbgenerated("gen_random_uuid()")) @map("qr_token") @db.Uuid
  ticketNumber Int?        @map("ticket_number")
  ticketDate   DateTime?   @map("ticket_date") @db.Date
  channel      Channel
  status       OrderStatus @default(PENDING)
  branchId     Int         @map("branch_id")
  customerId   Int?        @map("customer_id")
  subtotal     Decimal     @db.Decimal(10, 2)
  tax          Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt       DateTime?   @map("paid_at") @db.Timestamptz(3)
  readyAt      DateTime?   @map("ready_at") @db.Timestamptz(3)
  deliveredAt  DateTime?   @map("delivered_at") @db.Timestamptz(3)

  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  rating   Rating?

  @@unique([branchId, ticketDate, ticketNumber], map: "order_daily_ticket_key")
  @@map("order")
}

/// RF11: detalle de la comanda. Copia nombre y precio del momento: si el catálogo cambia, el ticket no.
/// Solo uno de food_id, drink_id o combo_id tiene valor, según type (CHECK en la migración).
model OrderItem {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  type      ProductType
  foodId    Int?        @map("food_id")
  drinkId   Int?        @map("drink_id")
  comboId   Int?        @map("combo_id")
  name      String
  quantity  Int
  unitPrice Decimal     @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal     @map("line_total") @db.Decimal(10, 2)

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  food  Food?  @relation(fields: [foodId], references: [id], onDelete: Restrict)
  drink Drink? @relation(fields: [drinkId], references: [id], onDelete: Restrict)
  combo Combo? @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@map("order_item")
}

/// RF13: pago simulado. Solo titular, marca, últimos 4 y vencimiento. Nunca número completo ni CVV.
model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int           @map("order_id")
  holderName String        @map("holder_name")
  brand      String
  last4      String        @db.Char(4)
  expMonth   Int           @map("exp_month")
  expYear    Int           @map("exp_year")
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus
  reference  String
  paidAt     DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("payment")
}

// ─── Dashboard ────────────────────────────────────────────────────────────────

/// Inversión en mercadeo, para costo de adquisición y ROI.
model MarketingExpense {
  id        Int      @id @default(autoincrement())
  campaign  String
  channel   String
  amount    Decimal  @db.Decimal(10, 2)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  branchId  Int?     @map("branch_id")

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@map("marketing_expense")
}

/// Satisfacción del cliente con una comanda.
model Rating {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique @map("order_id")
  stars     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("rating")
}
