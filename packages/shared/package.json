{
  "name": "@zarape/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos, enums de estatus y cálculo de la comanda, compartidos por la API y las apps.",
  "type": "module",
  "exports": {
    ".": {
      "@zarape/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
