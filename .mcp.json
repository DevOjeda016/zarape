{
  "mcpServers": {
    "shadcn": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/packages/ui/node_modules/shadcn/dist/index.js",
        "mcp",
        "--cwd",
        "${CLAUDE_PROJECT_DIR:-.}/packages/ui"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "prisma": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/apps/api/node_modules/prisma/build/index.js",
        "mcp"
      ]
    }
  }
}
